[Unit]
Description=webcomicchat resident bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/webcomicchat/web
EnvironmentFile=/etc/webcomicchat/bot.env
ExecStart=/usr/bin/npx tsx bot/index.ts
Restart=always
RestartSec=10
User=bettybot
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
