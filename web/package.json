{
  "name": "comic-chat-web-prototype",
  "private": true,
  "version": "0.17.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names web,gateway --prefix-colors blue,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p bot && vite build && npm run build:server && npm run build:bot && npm run build:cam",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "build:bot": "esbuild bot/index.ts --bundle --platform=node --format=esm --outfile=dist-bot/index.js",
    "start": "node dist-server/index.js",
    "start:dev": "tsx server/index.ts",
    "bot": "node dist-bot/index.js",
    "bot:dev": "tsx bot/index.ts",
    "test": "vitest run",
    "build:cam": "esbuild bot/cam.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-bot/cam.js",
    "cam": "node dist-bot/cam.js",
    "cam:dev": "tsx bot/cam.ts"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fontsource/comic-neue": "^5.3.0",
    "ws": "^8.21.3"
  }
}
